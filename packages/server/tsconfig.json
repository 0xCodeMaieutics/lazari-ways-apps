{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "esModuleInterop": true,
    "skipLibCheck": true,
    // Enable all strict type-checking options
    "strict": true,
    "strictNullChecks": true,
    "noUncheckedIndexedAccess": true,
    "checkJs": true,
    "isolatedModules": true,
    "outDir": "dist",

    // Generate corresponding '.d.ts' file
    "declaration": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "db/client": ["./src/db/generated/prisma/client.ts"]
    }
  },
  "include": ["./src/**/*"],
  "exclude": ["**/generated/**"]
}
