{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "esModuleInterop": true,
    "skipLibCheck": true,
    // Enable all strict type-checking options
    "strict": true,
    "strictNullChecks": true,
    "noUncheckedIndexedAccess": true,
    "checkJs": true,
    "isolatedModules": true
  },
  "include": ["./src/**/*"],
  "exclude": ["**/generated/**"]
}
