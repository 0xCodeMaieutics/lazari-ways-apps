{
  "name": "@workspace/server",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "build": "node esbuild.config.js && tsc -p tsconfig.build.json",
    "types": "tsc -p tsconfig.build.json",
    "build:watch": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:reset": "dotenv -e .env -- pnpm prisma migrate reset --skip-seed",
    "db:migrate": "dotenv -e .env -- prisma migrate dev",
    "db:deploy": "dotenv -e .env.prod -- prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:push": "prisma db push --force-reset",
    "db:push-seed": "prisma db push --force-reset && pnpm db:seed"
  },
  "exports": {
    "./db": "./dist/db/index.js",
    "./db/models": "./dist/db/models.js",
    "./auth": "./dist/auth/index.js",
    "./auth/client": "./dist/auth/client.js"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.1.0",
    "@types/node": "^20.19.9",
    "dotenv": "^17.2.3",
    "dotenv-cli": "^11.0.0",
    "esbuild": "^0.27.0",
    "esbuild-node-externals": "^1.20.1",
    "prisma": "^6.18.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "uncrypto": "^0.1.3",
    "vitest": "^4.0.8"
  },
  "peerDependencies": {
    "@aws-sdk/client-s3": "^3.922.0",
    "@aws-sdk/lib-storage": "^3.922.0",
    "@aws-sdk/s3-request-presigner": "^3.922.0",
    "@prisma/adapter-pg": "^6.19.0",
    "@prisma/client": "^6.18.0",
    "pg": "^8.16.3"
  },
  "dependencies": {
    "@workspace/shared": "workspace:*",
    "better-auth": "^1.3.34",
    "db": "link:src/db/generated/prisma",
    "zod": "^4.1.12"
  },
  "packageManager": "pnpm@9.4.0"
}
