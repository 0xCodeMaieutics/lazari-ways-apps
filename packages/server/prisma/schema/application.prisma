enum ApplicationStatus {
  USER_SUBMITTED

  IN_REVIEW_BY_AGENCY
  IN_REVIEW_BY_EMPLOYER

  APPROVED_BY_AGENCY
  APPROVED_BY_EMPLOYER

  REJECTED_BY_AGENCY
  REJECTED_BY_EMPLOYER
}

enum ApplicationType {
  KKB3
  KKB8
  STUDENT
}

model Application {
  id   String          @id
  type ApplicationType

  // Agency Information
  agencyName    String
  agencyAddress String

  // Study Information
  germanLevel        String?
  otherLanguages     String?
  driverLicense      String?
  canRideBike        Boolean?
  shiftWork          Boolean?
  healthRestrictions String?
  allergies          String?
  clothingSize       String?
  shoeSize           String?

  // Previous Experience
  hasBeenInCountryBefore Boolean
  previousStayCountry    String?
  previousStayPlace      String?
  previousStayPeriodFrom DateTime?
  previousStayPeriodTo   DateTime?

  // Contact Information
  phone     String
  email     String
  taxId     String?
  instagram String?

  // Files
  fotoKey                String
  passportKey            String
  languageCertificateKey String?
  studyCertificateKey    String?

  // Emergency Contact
  emergencyContactName  String
  emergencyContactPhone String

  status ApplicationStatus? @default(USER_SUBMITTED)

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  applicationStudent ApplicationStudent?
}

model ApplicationStudent {
  id          String      @id
  application Application @relation(fields: [id], references: [id])

  university        String?
  studySubject      String?
  semesterBreakFrom DateTime?
  semesterBreakTo   DateTime?

  certificateOfEnrollmentKey String? // Only for STUDENT visa
}
