enum ApplicationStatus {
  USER_SUBMITTED

  IN_REVIEW_BY_AGENCY
  IN_REVIEW_BY_EMPLOYER

  APPROVED_BY_AGENCY
  APPROVED_BY_EMPLOYER

  REJECTED_BY_AGENCY
  REJECTED_BY_EMPLOYER
}

enum ApplicationType {
  KKB3
  KKB8
  STUDENT
}

model Application {
  id   String          @id
  type ApplicationType

  status ApplicationStatus? @default(USER_SUBMITTED)

  // Only applies if type is STUDENT
  university        String?
  studySubject      String?
  semesterBreakFrom DateTime? 
  semesterBreakTo   DateTime? 
  studyCertificateKey    String?
  certificateOfEnrollmentKey String?

  passportKey            String
  languageCertificateKey String?

  germanLevel        String?
  otherLanguages     String?
  driverLicense      String?
  canRideBike        Boolean?
  shiftWork          Boolean?
  healthRestrictions String?
  allergies          String?
  clothingSize       String?
  shoeSize           String?

  hasBeenInGermanyBefore Boolean?
  previousStayPlace   String?
  previousStayPeriodFrom DateTime?
  previousStayPeriodTo   DateTime?
  
  emergencyContactName  String?
  emergencyContactPhone String?

  employeeId String?
  employee   Employee?   @relation(fields: [employeeId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}
