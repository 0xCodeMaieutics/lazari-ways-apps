model Vacancy {
  id             String   @id @default(cuid())
  vacancyId      Int      @unique // Special ID for the vacancy
  title          String // Bäcker
  location       String // Nähe Berlin, Germany
  beginDate      String
  duration       String // 6 months
  salary         String // 1200 EUR/month
  jobDescription String // Description of the job
  schedule       String // 40-50 საათი/კვირა; 9-10 საათი/დღე; 1 დღე/დასვენება
  accommodation  String // Unterkunft wird gestellt
  meals          String // Mahlzeiten werden gestellt
  availableTo    String? // მხოლოდ ქალბატონებისთვის
  languageLevel  String? // Grundkenntnisse in Deutsch
  additionalInfo String? //  Additional information
  hide           Boolean? @default(false)
  photos         String[]
  videos         String[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  reviews Review[]
}

model Review {
  id        String   @id @default(cuid())
  name      String
  review    String
  instagram String?
  vacancyId String
  vacancy   Vacancy  @relation(fields: [vacancyId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}
