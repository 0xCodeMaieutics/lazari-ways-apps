enum EmploymentType {
  FULL_TIME
  PART_TIME
  INTERN
  VOLUNTEER
}

model Vacancy {
  id             String         @id
  vacancyId      Int            @unique
  vacancyName    String
  title          String
  location       String
  startDate      DateTime
  description    String         @db.Text
  priceMin       Int
  priceMax       Int
  requirements   String[]
  benefits       String[]
  employmentType EmploymentType
  imageUrl       String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

}
