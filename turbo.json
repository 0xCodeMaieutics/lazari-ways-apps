{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["@workspace/server#db:generate", "^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "env": ["DATABASE_URL"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "db:generate": {
      "outputs": ["src/db/generated/prisma/**"],
      "cache": false
    },
    "db:migrate": {
      "cache": false,
      "persistent": true
    },
    "db:deploy": {
      "cache": false
    }
  },
  "globalEnv": [
    "DIRECT_URL",
    "DATABASE_URL",
    "NODE_ENV",
    "TELEGRAM_BOT_TOKEN",
    "TELEGRAM_BOT_CHAT_ID",
    "AWS_ACCESS_KEY_ID",
    "AWS_SECRET_ACCESS_KEY",
    "AWS_REGION",
    "S3_BUCKET_NAME",
    "AWS_BUCKET_NAME",
    "NEXT_PUBLIC_BASE_URL",
    "JOSE_SECRET",
    "BETTER_AUTH_SECRET",
    "SKIP_ENV_VALIDATION",
    "PASSWORD_ENCRYPTION_KEY",
    "S3_REGION",
    "S3_ENDPOINT",
    "S3_ACCESS_KEY",
    "S3_SECRET_KEY",
    "S3_BUCKET_VACANCIES"
  ]
}
